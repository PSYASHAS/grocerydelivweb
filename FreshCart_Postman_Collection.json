            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": {\n    \"name\": \"Rohan Sharma\",\n    \"phone\": \"9876543210\",\n    \"email\": \"rohan@freshcart.com\",\n    \"address\": {\n      \"street\": \"Indiranagar 100ft Road\",\n      \"city\": \"Bengaluru\",\n      \"pincode\": \"560038\"\n    }\n  },\n  \"paymentMethod\": \"UPI\",\n  \"items\": [\n    {\n      \"productId\": \"prod_001\",\n      \"name\": \"Farm Fresh Red Tomatoes\",\n      \"quantity\": 2\n    },\n    {\n      \"productId\": \"prod_006\",\n      \"name\": \"Amul Taaza Fresh Toned Milk\",\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": {
