            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Fresh Organic Broccoli\",\n  \"category\": \"Fruits & Vegetables\",\n  \"price\": 70,\n  \"discountPrice\": 55,\n  \"stockQuantity\": 25,\n  \"unit\": \"500 g\",\n  \"image\": \"https://images.unsplash.com/photo-1584270354949-c26b0d5b4a0c?w=500\",\n  \"description\": \"Crisp green florets packed with sulforaphane and Vitamin C.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            }
          }
        }
      ]
