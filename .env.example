# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# For local MongoDB: mongodb://localhost:27017/freshcart_db
# For MongoDB Atlas Cloud: mongodb+srv://<username>:<password>@cluster0.mongodb.net/freshcart_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/freshcart_db

# JWT Secret for Authentication
JWT_SECRET=freshcart_jwt_secret_key_2026_super_secure

# Delivery Fee Rules
FREE_DELIVERY_THRESHOLD=499
STANDARD_DELIVERY_FEE=40
